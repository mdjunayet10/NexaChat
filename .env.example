DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=NexaChat <no-reply@nexachat.local>
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# AI chat uses the deterministic offline provider by default.
AI_PROVIDER=mock
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=512
AI_TEMPERATURE=0.7
AI_CONTEXT_MESSAGE_LIMIT=20
AI_SYSTEM_PROMPT=You are NexaChat, a helpful and concise AI assistant.

# Required only when AI_PROVIDER=openrouter. Never commit a real API key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=NexaChat
