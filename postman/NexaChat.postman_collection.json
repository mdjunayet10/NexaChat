    {
      "name": "Password Reset",
      "description": "After requesting a reset, copy the raw token from the Django runserver console email into the reset_token environment variable.",
      "item": [
        {
          "name": "Request Reset",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{base_url}}/api/accounts/password-reset/request/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Raw token is not returned', () => pm.expect(pm.response.text()).not.to.include('reset_token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Reset Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"token\": \"{{reset_token}}\"\n}"
            },
            "url": "{{base_url}}/api/accounts/password-reset/verify/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token is valid', () => pm.expect(pm.response.json().valid).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm Reset",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"token\": \"{{reset_token}}\",\n  \"new_password\": \"{{new_password}}\",\n  \"new_password_confirm\": \"{{new_password}}\"\n}"
            },
            "url": "{{base_url}}/api/accounts/password-reset/confirm/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
