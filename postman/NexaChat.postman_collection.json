    {
      "name": "AI Chat",
      "item": [
        {
          "name": "Complete AI Chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"What is Django REST Framework?\"\n}"
            },
            "url": "{{base_url}}/api/chats/sessions/{{session_id}}/chat/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test('Complete response exists', () => { pm.expect(data).to.have.property('user_message'); pm.expect(data).to.have.property('assistant_message'); pm.expect(data).to.have.property('usage'); });",
                  "if (data.user_message && data.user_message.id) pm.environment.set('message_id', data.user_message.id);",
                  "if (data.assistant_message && data.assistant_message.id) pm.environment.set('assistant_message_id', data.assistant_message.id);"
                ]
              }
            }
          ]
        }
      ]
